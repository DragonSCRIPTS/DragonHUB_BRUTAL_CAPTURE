-- ============================================================================
-- SISTEMA DE HOOKS NATIVOS
-- ============================================================================

local NativeHooks = {}
local originalFunctions = {}
local hookStates = {}

-- Funções críticas para hook
local CRITICAL_FUNCTIONS = {
    "loadstring", "require", "pcall", "xpcall", "spawn", "coroutine.create",
    "coroutine.resume", "debug.getfenv", "debug.setfenv", "getrawmetatable",
    "setrawmetatable", "newcclosure", "islclosure", "getgenv", "getrenv"
}

-- Hook Manager com C-Closure
local function createBrutalHook(functionName, originalFunc)
    local hookId = #NativeHooks + 1
    local callCount = 0
    local lastCall = 0
    
    -- Cria C-Closure para bypass de detecção
    local hookedFunction = newcclosure(function(...)
        callCount = callCount + 1
        lastCall = tick()
        
        -- Captura argumentos
        local args = {...}
        local argData = {}
        
        for i, arg in ipairs(args) do
            argData[i] = {
                type = type(arg),
                value = type(arg) == "string" and arg or tostring(arg),
                size = type(arg) == "string" and #arg or 0
            }
        end
        
        -- Log da chamada
        BrutalCapture:LogInterception({
            function_name = functionName,
            hook_id = hookId,
            call_count = callCount,
            timestamp = lastCall,
            args = argData,
            stack_trace = debug.traceback()
        })
        
        -- Executa função original
        local results = {pcall(originalFunc, ...)}
        local success = results[1]
        table.remove(results, 1)
        
        -- Captura resultado
        if success and #results > 0 then
            for i, result in ipairs(results) do
                if type(result) == "string" then
                    -- Envia para deobfuscação brutal
                    spawn(function()
                        BrutalCapture:BrutalDeobfuscate(result, {
                            source_function = functionName,
                            hook_id = hookId,
                            call_context = args
                        })
                    end)
                end
            end
        end
        
        return unpack(results)
    end)
    
    NativeHooks[hookId] = {
        name = functionName,
        original = originalFunc,
        hooked = hookedFunction,
        stats = {
            calls = 0,
            lastCall = 0,
            errors = 0
        }
    }
    
    return hookedFunction
end

-- Instala hooks brutais
local function installBrutalHooks()
    for _, funcName in ipairs(CRITICAL_FUNCTIONS) do
        local func = getgenv()[funcName]
        if func and type(func) == "function" then
            originalFunctions[funcName] = func
            local hookedFunc = createBrutalHook(funcName, func)
            getgenv()[funcName] = hookedFunc
            hookStates[funcName] = true
        end
    end
    
    -- Hook especial para game:GetObjects
    if game.GetObjects then
        originalFunctions["game:GetObjects"] = game.GetObjects
        game.GetObjects = createBrutalHook("game:GetObjects", game.GetObjects)
    end
end

