-- Inicia captura brutal
function BrutalCapture:StartBrutalCapture(options)
    options = options or {}
    
    -- Atualiza configurações
    for key, value in pairs(options) do
        if BRUTAL_CONFIG[key] then
            BRUTAL_CONFIG[key] = value
        end
    end
    
    print("🔥 INICIANDO CAPTURA BRUTAL")
    print("⚠️  MODO EXTREMO ATIVADO")
    
    -- Inicializa sistemas
    installBrutalHooks()
    initializeDeobfuscationThreads()
    calculateFPS()
    
    -- Loop principal
    spawn(function()
        while true do
            -- Scanner adaptativo
            adaptiveScan()
            
            -- Sistema de evasão
            applyEvasionPattern()
            
            -- Processa threads de deobfuscação
            for i, thread in pairs(processingThreads) do
                if thread and coroutine.status(thread) == "suspended" then
                    coroutine.resume(thread)
                end
            end
            
            -- Salva buffer se necessário
            if #pendingSaves > 0 then
                saveBatch()
            end
            
            wait(0.1)
        end
    end)
    
    return true
end

-- Desobfuscação brutal
function BrutalCapture:BrutalDeobfuscate(code, metadata)
    table.insert(deobfuscationQueue, {
        code = code,
        metadata = metadata,
        timestamp = tick()
    })
end

-- Scan profundo de container
function BrutalCapture:DeepScanContainer(container)
    if not container then return end
    
    local scanned = {}
    
    local function scanRecursive(obj)
        if scanned[obj] then return end
        scanned[obj] = true
        
        -- Captura tudo
        if obj:IsA("LuaSourceContainer") then
            local success, source = pcall(function()
                return obj.Source
            end)
            
            if success and source then
                self:BrutalDeobfuscate(source, {
                    object = obj,
                    type = "script",
                    path = obj:GetFullName()
                })
            end
        end
        
        -- Verifica propriedades protegidas
        for _, property in pairs({"Source", "Value", "Text", "Script"}) do
            local success, value = pcall(function()
                return obj[property]
            end)
            
            if success and type(value) == "string" then
                self:BrutalDeobfuscate(value, {
                    object = obj,
                    property = property,
                    type = "property"
                })
            end
        end
        
        -- Escaneia filhos
        for _, child in pairs(obj:GetChildren()) do
            scanRecursive(child)
        end
    end
    
    scanRecursive(container)
end

-- Logs de interceptação
function BrutalCapture:LogInterception(data)
    addToBuffer({
        type = "interception",
        data = data
    })
end

-- Logs de execução
function BrutalCapture:LogExecution(data)
    addToBuffer({
        type = "execution",
        data = data
    })
end

-- Reporta deobfuscação
function BrutalCapture:ReportDeobfuscation(result)
    addToBuffer({
        type = "deobfuscation",
        data = result
    })
    
    print("🔓 Deobfuscação concluída:", #result.changes, "mudanças")
end

-- Para captura brutal
function BrutalCapture:StopBrutalCapture()
    -- Restaura funções originais
    for funcName, originalFunc in pairs(originalFunctions) do
        getgenv()[funcName] = originalFunc
    end
    
    -- Salva buffer final
    saveBatch()
    
    print("🛑 CAPTURA BRUTAL FINALIZADA")
    
    return {
        hooks_restored = #originalFunctions,
        final_buffer_size = #buffer,
        total_deobfuscations = #deobfuscationQueue
    }
end

-- Obtém estatísticas
function BrutalCapture:GetBrutalStats()
    return {
        hooks_active = #NativeHooks,
        buffer_size = #buffer,
        deobfuscation_queue = #deobfuscationQueue,
        current_fps = scanStats.currentFPS,
        evasion_level = evasionState.currentPattern,
        detection_level = evasionState.detectionLevel
    }
end

-- Função de utilidade para hash
function generateHash(content)
    local hash = 0
    for i = 1, #content do
        hash = hash + string.byte(content, i) * i
    end
    return tostring(hash)
end

